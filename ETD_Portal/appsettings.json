{
  "ConnectionStrings": {
      "ETDPortalDb": "Server=(localdb)\\MSSQLLocalDB;Database=ETD_Portal;Trusted_Connection=True;TrustServerCertificate=True;"
},
"Jwt": {
  "SecretKey": "your-minimum-32-character-secret-key!!",
  "Issuer": "TravelDeskPortal",
  "Audience": "TravelDeskUsers",
  "TokenExpiryMinutes": "25",
  "RefreshTokenExpiryDays": "7"
},

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "Properties": {
      "Application": "ETD_Portal"
    }
  },
  "AllowedHosts": "*"
}

