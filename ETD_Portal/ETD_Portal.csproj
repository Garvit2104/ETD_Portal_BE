<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Reimbursement\**" />
    <Compile Remove="Reservations\**" />
    <Content Remove="Reimbursement\**" />
    <Content Remove="Reservations\**" />
    <EmbeddedResource Remove="Reimbursement\**" />
    <EmbeddedResource Remove="Reservations\**" />
    <None Remove="Reimbursement\**" />
    <None Remove="Reservations\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.29.0" />
